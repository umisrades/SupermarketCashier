  <property name="styleSheet">
   <string notr="true">QWidget {
    font-family: "Microsoft YaHei";
    font-size: 14px;
    background-color: black;
    color: white;
}
QGroupBox {
    font-weight: bold;
    border: 1px solid #333333;
    border-radius: 8px;
    margin-top: 12px;
    padding-top: 8px;
    background-color: #1a1a1a;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 6px;
    color: white;
}
QPushButton {
    min-height: 32px;
    padding: 0 18px;
    border: none;
    border-radius: 6px;
    background-color: #667eea;
    color: white;
    font-weight: 500;
}
QPushButton:hover {
    background-color: #5a6fd6;
}
QPushButton:pressed {
    background-color: #4e63c4;
}
QPushButton#closeButton {
    background-color: #666666;
}
QPushButton#closeButton:hover {
    background-color: #555555;
}
QPushButton#confirmButton {
    background-color: #10b981;
}
QPushButton#confirmButton:hover {
    background-color: #059669;
}
QLineEdit, QComboBox, QSpinBox, QPlainTextEdit {
    min-height: 30px;
    border: 1px solid #444444;
    border-radius: 6px;
    padding: 0 8px;
    background-color: #2a2a2a;
    color: white;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QPlainTextEdit:focus {
    border-color: #667eea;
    outline: none;
}
QComboBox {
    padding-right: 24px;
}
QComboBox QAbstractItemView {
    background-color: #2a2a2a;
    color: white;
    border: 1px solid #444444;
}
QSpinBox::up-button, QSpinBox::down-button {
    background-color: #333333;
    border: none;
}
QCheckBox {
    spacing: 6px;
    color: white;
}
QLabel {
    color: white;
}
#titleLabel {
    font-size: 26px;
    font-weight: bold;
    color: white;
}
#lowStockValueLabel {
    color: #ef4444;
    font-weight: bold;
    font-size: 18px;
}
#totalProductsValueLabel, #totalStockValueLabel, #outOfStockValueLabel {
    font-size: 18px;
    font-weight: bold;
    color: white;
}
#statusTipLabel {
    color: #999999;
}
#selectedProductLabel {
    font-weight: 500;
    color: white;
}</string>
